# Copy to .env (repo root, read by docker compose) and/or backend/.env (read by the API),
# or run scripts/gen-env.sh to generate both with random values. Never commit .env.
# Without ANTHROPIC_API_KEY, Cairn runs on the deterministic sandbox models.
ANTHROPIC_API_KEY=
CAIRN_MODEL_MODE=auto
CAIRN_ENV=development

# Docker compose only (the database container's superuser password). With compose, the URLs
# below use the host "db" instead of localhost.
POSTGRES_PASSWORD=

# The app role is subject to row-level security; the admin URL runs migrations.
CAIRN_DATABASE_URL=postgresql://cairn_app:<app-password>@localhost:5432/cairn
CAIRN_ADMIN_DATABASE_URL=postgresql://postgres:<admin-password>@localhost:5432/cairn

# Required when CAIRN_ENV=production. In development they are generated into
# backend/.cairn-dev-keys.json (gitignored) if unset.
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
CAIRN_SECRET_KEY=
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
CAIRN_MASTER_KEY=
CAIRN_PUBLIC_URL=http://localhost:8000
